{
  "manifest_version": 3,
  "name": "Netflix Windowed Games",
  "version": "1.0.0",
  "description": "Keeps Netflix browser games running in a window instead of forcing fullscreen, so you can FaceTime / multitask alongside.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.netflix.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Netflix Windowed Games",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
